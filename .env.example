# Copy this file to `.env` and edit. Restart `npx expo start -c` after changing it.
# Only variables that start with EXPO_PUBLIC_ are visible to the app (and are NOT secret).

# Which backend the app talks to:
#   local      -> EXPO_PUBLIC_API_URL_LOCAL   (your laptop, `docker compose up`)
#   production -> EXPO_PUBLIC_API_URL_PROD    (your deployed server)
# Leave empty to auto-pick: "local" while developing, "production" in release builds.
EXPO_PUBLIC_APP_ENV=

# Local backend. Keep "localhost" and the app swaps in your computer's LAN IP
# automatically when you run on a real phone (see src/config/env.ts).
EXPO_PUBLIC_API_URL_LOCAL=http://localhost:8000

# Production backend (no trailing slash). MUST be https:// for real users.
EXPO_PUBLIC_API_URL_PROD=https://api.example.com
